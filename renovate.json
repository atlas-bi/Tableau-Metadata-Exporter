{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":rebaseStalePrs"
  ],
  "baseBranches": ["dev"],
  "commitMessagePrefix": "chore(deps)",
  "labels": ["maintenance", "renovate"],
  "timezone": "America/Chicago",
  "schedule": ["before 10pm on the first day of the month"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 10pm on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Group all dependency updates into one monthly PR",
      "matchManagers": ["pep621", "uv", "github-actions", "pre-commit"],
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies"
    },
    {
      "matchUpdateTypes": ["pin", "digest", "minor", "patch"],
      "automerge": true
    }
  ]
}
